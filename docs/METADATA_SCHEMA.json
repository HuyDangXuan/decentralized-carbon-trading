{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://epu-carbonchain.vn/schema/carbon-credit-metadata-v2.json",
  "title": "EPU CarbonChain – Carbon Credit ERC-1155 Metadata Schema",
  "description": "Metadata dự án CarbonChain theo README và ADR-001: tín chỉ nguyên tCO2e, giá micro-USDC, buffer 10–20%. Đây là quy ước nội bộ dự án, không phải chứng nhận tuân thủ registry.",
  "type": "object",
  "required": [
    "name",
    "description",
    "image",
    "decimals",
    "unit",
    "price_unit",
    "price_decimals",
    "properties"
  ],
  "properties": {
    "name": {
      "type": "string",
      "description": "Tên hiển thị của lô tín chỉ. Định dạng: 'Carbon Credit - {project_name} ({vintage_year})'.",
      "examples": [
        "Carbon Credit - Dự án Trồng Rừng Phòng Hộ Tây Bắc (2026)"
      ],
      "minLength": 1
    },
    "description": {
      "type": "string",
      "description": "Mô tả ngắn gọn về tín chỉ, bao gồm tiêu chuẩn áp dụng.",
      "examples": [
        "Verified Carbon Credit under standard Verra VCS + CCB"
      ],
      "minLength": 1
    },
    "image": {
      "type": "string",
      "format": "uri",
      "description": "URI ảnh đại diện dự án trên IPFS (CID v1 hoặc v0).",
      "pattern": "^ipfs://",
      "examples": [
        "ipfs://bafybeihdwdcefgh4dqkjv678projectcoverimage"
      ]
    },
    "decimals": {
      "type": "integer",
      "const": 0,
      "description": "Cố định 0: một token là một tCO2e nguyên."
    },
    "unit": {
      "type": "string",
      "const": "tCO2e",
      "description": "Đơn vị tín chỉ thống nhất toàn dự án."
    },
    "price_unit": {
      "type": "string",
      "const": "USDC",
      "description": "Ký hiệu tiền định giá; token thanh toán testnet là MockUSDC."
    },
    "price_decimals": {
      "type": "integer",
      "const": 6,
      "description": "Một USDC bằng 1.000.000 micro-USDC."
    },
    "properties": {
      "type": "object",
      "description": "Tập hợp thuộc tính mở rộng chứa toàn bộ thông tin nghiệp vụ MRV, Verra VCS và Gold Standard.",
      "required": [
        "project_id",
        "standard",
        "vintage_year",
        "total_issued_tCO2e",
        "developer",
        "verifier",
        "verified_at",
        "status",
        "methodology",
        "country",
        "region",
        "additionality",
        "permanence_risk_buffer",
        "asset_class",
        "standard_category",
        "vintage_window",
        "is_fungible_pool"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "description": "Mã định danh duy nhất của dự án. Tuân thủ quy ước: {QUỐC GIA}-{LOẠI}-{NĂM}-{SỐ THỨ TỰ}. Ví dụ Verra: 'VCS-1234', Gold Standard: 'GS-5678'.",
          "pattern": "^[A-Z]{2,3}-[A-Z]{2,5}-[0-9]{4}-[0-9]{3,6}$|^VCS-[0-9]+$|^GS-[0-9]+$",
          "examples": [
            "VN-FOR-2026-001",
            "VCS-2345",
            "GS-6789"
          ]
        },
        "standard": {
          "type": "string",
          "description": "Tiêu chuẩn chứng nhận tín chỉ carbon áp dụng.",
          "enum": [
            "Verra VCS",
            "Verra VCS + CCB",
            "Verra VCS + SD VISta",
            "Gold Standard VER",
            "Gold Standard CER",
            "CDM",
            "Vietnam VCM",
            "Article 6.4"
          ]
        },
        "methodology": {
          "type": "string",
          "description": "Phương pháp luận tính toán giảm phát thải (Methodology). Verra: VM0007, VM0015, VM0042… Gold Standard: GS-METH-001…",
          "examples": [
            "VM0007 - REDD+ Methodology Framework",
            "VM0015 - Avoided Unplanned Deforestation",
            "VM0042 - Improved Cookstoves",
            "GS-TPDDTEC - Technologies and Practices to Displace Decentralized Thermal Energy Consumption"
          ],
          "minLength": 1
        },
        "project_type": {
          "type": "string",
          "description": "Phân loại lĩnh vực dự án theo Verra Sectoral Scope hoặc Gold Standard Project Type.",
          "enum": [
            "FORESTRY_AFOLU",
            "RENEWABLE_ENERGY",
            "ENERGY_EFFICIENCY",
            "COOKSTOVE",
            "WASTE_MANAGEMENT",
            "TRANSPORT",
            "INDUSTRIAL_GAS",
            "BLUE_CARBON",
            "AGRICULTURE",
            "OTHER"
          ]
        },
        "asset_class": {
          "type": "string",
          "description": "Phân loại để lọc và đánh giá tương đương; không tự cấp quyền khớp chéo tokenId.",
          "enum": [
            "forestry",
            "renewable_energy",
            "waste_treatment",
            "energy_efficiency",
            "cookstove",
            "blue_carbon",
            "agriculture",
            "transport",
            "industrial_gas",
            "other"
          ]
        },
        "standard_category": {
          "type": "string",
          "description": "Danh mục tiêu chuẩn rút gọn dùng cho phân nhóm fungibility. Ánh xạ từ trường 'standard' sang nhóm đơn giản hơn để engine giao dịch ghép lệnh.",
          "enum": [
            "Verra_VCS",
            "Gold_Standard",
            "CDM",
            "Vietnam_VCM",
            "Article_6_4"
          ]
        },
        "vintage_window": {
          "type": "object",
          "description": "Cửa sổ năm vintage, bao gồm hai đầu. Bộ kiểm tra nghiệp vụ xác minh start_year <= vintage_year <= end_year.",
          "properties": {
            "start_year": {
              "type": "integer",
              "minimum": 2000,
              "maximum": 2100,
              "description": "Năm bắt đầu cửa sổ vintage (bao gồm)."
            },
            "end_year": {
              "type": "integer",
              "minimum": 2000,
              "maximum": 2100,
              "description": "Năm kết thúc cửa sổ vintage (bao gồm). Phải >= start_year."
            }
          },
          "required": [
            "start_year",
            "end_year"
          ]
        },
        "is_fungible_pool": {
          "type": "boolean",
          "default": false,
          "description": "Cờ khai báo lô đủ điều kiện tham gia nhóm phân loại. Khớp chéo tokenId còn phụ thuộc phê duyệt và khả năng của Engine/contract; frontend hiện gửi đúng một tokenId."
        },
        "vintage_year": {
          "type": "integer",
          "minimum": 2000,
          "maximum": 2100,
          "description": "Năm vintage – năm mà lượng giảm phát thải thực sự xảy ra (không phải năm phát hành)."
        },
        "vintage_period": {
          "type": "object",
          "description": "Khoảng thời gian giám sát cụ thể của đợt vintage (Monitoring Period).",
          "properties": {
            "start_date": {
              "type": "string",
              "format": "date",
              "description": "Ngày bắt đầu chu kỳ giám sát (ISO 8601)."
            },
            "end_date": {
              "type": "string",
              "format": "date",
              "description": "Ngày kết thúc chu kỳ giám sát (ISO 8601)."
            }
          },
          "required": [
            "start_date",
            "end_date"
          ]
        },
        "total_issued_tCO2e": {
          "type": "integer",
          "description": "Tổng số tín chỉ carbon được phê duyệt phát hành trong đợt này (đơn vị: tấn CO2 tương đương – tCO2e).",
          "minimum": 1,
          "maximum": 340282366920938463463374607431768211455
        },
        "serial_number_range": {
          "type": "object",
          "description": "Dải số serial theo quy định Verra Registry hoặc Gold Standard Impact Registry.",
          "properties": {
            "start": {
              "type": "string",
              "description": "Số serial bắt đầu.",
              "examples": [
                "VCS-123-2026-VN-FOR-001-1"
              ]
            },
            "end": {
              "type": "string",
              "description": "Số serial kết thúc.",
              "examples": [
                "VCS-123-2026-VN-FOR-001-5000"
              ]
            }
          },
          "required": [
            "start",
            "end"
          ]
        },
        "country": {
          "type": "string",
          "description": "Mã quốc gia nơi dự án triển khai (ISO 3166-1 alpha-2).",
          "pattern": "^[A-Z]{2}$",
          "default": "VN",
          "examples": [
            "VN",
            "ID",
            "BR",
            "IN"
          ]
        },
        "region": {
          "type": "string",
          "description": "Khu vực / tỉnh thành cụ thể nơi dự án triển khai.",
          "examples": [
            "Sơn La",
            "Lào Cai",
            "Đắk Lắk"
          ],
          "minLength": 1
        },
        "coordinates": {
          "type": "object",
          "description": "Tọa độ GPS trung tâm vùng dự án.",
          "properties": {
            "latitude": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "longitude": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          },
          "required": [
            "latitude",
            "longitude"
          ]
        },
        "developer": {
          "type": "string",
          "description": "Địa chỉ ví Ethereum (hoặc tên tổ chức) của chủ dự án / bên phát triển.",
          "examples": [
            "0x71C7656EC7ab88b098defB751B7401B5f6d8976F",
            "Vietnam Forest Corporation"
          ],
          "minLength": 1
        },
        "developer_name": {
          "type": "string",
          "description": "Tên đầy đủ tổ chức phát triển dự án.",
          "examples": [
            "Công ty TNHH Trồng Rừng Xanh Tây Bắc"
          ]
        },
        "verifier": {
          "type": "string",
          "description": "Tên đơn vị thẩm tra/kiểm định (VVB – Validation/Verification Body) hoặc ID tác tử tự động.",
          "examples": [
            "EPU_Decentralized_Carbon_Auditor",
            "SCS Global Services",
            "TÜV SÜD"
          ],
          "minLength": 1
        },
        "verification_body_id": {
          "type": "string",
          "description": "Mã định danh VVB trên registry (nếu có).",
          "examples": [
            "VVB-0042"
          ]
        },
        "verified_at": {
          "type": "integer",
          "description": "Unix timestamp (giây) thời điểm MRV Agent hoàn tất thẩm tra. Tương thích với trường verified_at trong MRVVerificationAgent.",
          "examples": [
            1730000000
          ],
          "minimum": 0
        },
        "verification_report_uri": {
          "type": "string",
          "format": "uri",
          "description": "URI trỏ tới bản báo cáo thẩm tra đầy đủ lưu trên IPFS.",
          "pattern": "^ipfs://",
          "examples": [
            "ipfs://QmVerificationReportHash1234567890abcdef"
          ]
        },
        "status": {
          "type": "string",
          "description": "Trạng thái hiện tại của lô tín chỉ trên hệ thống CarbonChain.",
          "enum": [
            "PENDING_VERIFICATION",
            "VERIFIED_ACTIVE",
            "LISTED_FOR_SALE",
            "PARTIALLY_RETIRED",
            "FULLY_RETIRED",
            "SUSPENDED",
            "CANCELLED"
          ],
          "default": "VERIFIED_ACTIVE"
        },
        "retirement_details": {
          "type": "object",
          "description": "Thông tin tiêu hủy (chỉ có khi status là PARTIALLY_RETIRED hoặc FULLY_RETIRED). Tương thích với RetirementComplianceAgent.",
          "properties": {
            "retired_amount_tCO2e": {
              "type": "integer",
              "minimum": 0,
              "description": "Số lượng tín chỉ đã tiêu hủy vĩnh viễn."
            },
            "beneficiary_company": {
              "type": "string",
              "description": "Tên doanh nghiệp hưởng thụ quyền bù đắp."
            },
            "retirement_reason": {
              "type": "string",
              "description": "Lý do / mục đích tiêu hủy tín chỉ.",
              "examples": [
                "Bù đắp phát thải Scope 1 - Quý 4/2026"
              ]
            },
            "retirement_timestamp": {
              "type": "integer",
              "description": "Unix timestamp thời điểm tiêu hủy."
            },
            "certificate_hash": {
              "type": "string",
              "pattern": "^0x[a-fA-F0-9]{64}$",
              "description": "Mã hash SHA-256 chứng nhận ESG bất biến trên blockchain."
            }
          }
        },
        "sdg_contributions": {
          "type": "array",
          "description": "Danh sách các Mục tiêu Phát triển Bền vững (SDGs) mà dự án đóng góp. Bắt buộc với Gold Standard, khuyến nghị với Verra VCS + SD VISta.",
          "items": {
            "type": "object",
            "properties": {
              "sdg_number": {
                "type": "integer",
                "minimum": 1,
                "maximum": 17,
                "description": "Số thứ tự SDG (1-17)."
              },
              "sdg_name": {
                "type": "string",
                "description": "Tên SDG."
              },
              "contribution_description": {
                "type": "string",
                "description": "Mô tả ngắn gọn đóng góp cụ thể."
              }
            },
            "required": [
              "sdg_number"
            ]
          },
          "examples": [
            [
              {
                "sdg_number": 13,
                "sdg_name": "Climate Action",
                "contribution_description": "Giảm 5000 tCO2e/năm qua trồng rừng"
              },
              {
                "sdg_number": 15,
                "sdg_name": "Life on Land",
                "contribution_description": "Phục hồi 200ha rừng phòng hộ"
              }
            ]
          ]
        },
        "additionality": {
          "type": "string",
          "description": "Kết quả đánh giá tính bổ sung (Additionality Assessment) – dự án chỉ khả thi nhờ cơ chế tín chỉ carbon.",
          "enum": [
            "PROVEN",
            "CONDITIONAL",
            "NOT_ASSESSED"
          ]
        },
        "permanence_risk_buffer": {
          "type": "number",
          "minimum": 10,
          "maximum": 20,
          "description": "Tỷ lệ trích lập của giao thức CarbonChain, đơn vị phần trăm; 10–20%. Chuyển sang basis points bằng nhân 100, không làm tròn ngầm."
        },
        "corresponding_adjustment": {
          "type": "boolean",
          "default": false,
          "description": "Đánh dấu tín chỉ đã được điều chỉnh tương ứng (Corresponding Adjustment) theo Điều 6 Thỏa thuận Paris, tránh double counting giữa các quốc gia."
        },
        "fungibility_group_id": {
          "type": "string",
          "description": "Mã nhóm duy nhất: {asset_class}_{start_year}-{end_year}_{standard_category}; mọi lô trong nhóm phải có cùng cửa sổ và tiêu chuẩn.",
          "pattern": "^[a-z_]+_[0-9]{4}-[0-9]{4}_[A-Za-z_]+$",
          "examples": [
            "forestry_2025-2027_Verra_VCS",
            "cookstove_2026-2026_Gold_Standard"
          ]
        },
        "content_hash": {
          "type": "string",
          "pattern": "^0x[a-fA-F0-9]{64}$",
          "description": "Mã hash SHA-256 của toàn bộ metadata JSON (trước khi thêm trường này). Dùng để xác minh tính toàn vẹn on-chain. Sinh bởi MRVVerificationAgent.",
          "examples": [
            "0xa1b2c3d4e5f6789012345678901234567890abcdef1234567890abcdef123456"
          ]
        }
      },
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "standard": {
                "enum": [
                  "Gold Standard VER",
                  "Gold Standard CER"
                ]
              }
            },
            "required": [
              "standard"
            ]
          },
          "then": {
            "required": [
              "sdg_contributions"
            ],
            "properties": {
              "sdg_contributions": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "is_fungible_pool": {
                "const": true
              }
            },
            "required": [
              "is_fungible_pool"
            ]
          },
          "then": {
            "required": [
              "fungibility_group_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "PARTIALLY_RETIRED",
                  "FULLY_RETIRED"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "retirement_details"
            ],
            "properties": {
              "retirement_details": {
                "required": [
                  "retired_amount_tCO2e",
                  "beneficiary_company",
                  "retirement_reason",
                  "retirement_timestamp"
                ]
              }
            }
          }
        }
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "example_verra_vcs": {
      "description": "Ví dụ metadata đầy đủ tuân thủ Verra VCS – tương thích đầu ra MRVVerificationAgent",
      "const": {
        "name": "Carbon Credit - Dự án Trồng Rừng Phòng Hộ Tây Bắc (2026)",
