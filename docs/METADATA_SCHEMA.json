            },
            {
              "sdg_number": 7,
              "sdg_name": "Affordable and Clean Energy",
              "contribution_description": "Bếp cải tiến tiết kiệm 60% nhiên liệu"
            },
            {
              "sdg_number": 13,
              "sdg_name": "Climate Action",
              "contribution_description": "Giảm 12000 tCO2e/năm"
            }
