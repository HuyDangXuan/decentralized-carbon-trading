      }
    },
    "example_gold_standard": {
      "description": "Ví dụ metadata tuân thủ Gold Standard VER",
      "const": {
        "name": "Carbon Credit - Chương trình Bếp Sạch Cộng đồng Mekong (2026)",
        "description": "Verified Carbon Credit under standard Gold Standard VER",
        "image": "ipfs://bafybeigoldstandardprojectimage",
        "decimals": 0,
        "unit": "tCO2e",
        "price_unit": "USDC",
        "price_decimals": 6,
        "properties": {
          "project_id": "GS-9012",
          "standard": "Gold Standard VER",
          "methodology": "GS-TPDDTEC - Technologies and Practices to Displace Decentralized Thermal Energy Consumption",
          "project_type": "COOKSTOVE",
          "vintage_year": 2026,
          "vintage_period": {
